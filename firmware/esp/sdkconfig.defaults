# Bleep v1: ESP32-S3-WROOM-1-N8R2 (8 MB quad flash, 2 MB quad PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# the firmware version is in version.txt (one number to bump per build: CLAUDE.md)
# CONFIG_APP_PROJECT_VER_FROM_CONFIG is not set

# PSRAM (quad: the octal kind would take GPIO35-37, which are LCD D0-D2)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Console on the native USB (GPIO43/44 are LCD D7 and WR, not UART0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS: 1 ms ticks for LVGL and the key scan
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Power management: frequency scaling and light sleep while awake (REQUIREMENTS.md)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Bluetooth LE only, NimBLE, as a HID peripheral
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Bleep"
# its buffers in PSRAM: internal RAM is short
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Updates over HTTPS with rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# LVGL: our lv_conf.h (main/), not Kconfig
CONFIG_LV_CONF_SKIP=n

# Internal RAM is what runs out (Wi-Fi, Bluetooth, TLS, the draw buffers): what
# doesn't need to be there goes to PSRAM or flash. Measured on the board.
# PSRAM holds LVGL's widgets: longer lines (no RAM cost)
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# TLS buffers in PSRAM (the update check ran out without)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# a remote needs little throughput
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# Wi-Fi up faster after a wake: no ARP probe of the offered address (about a
# second), and ask the router for the last address straight away
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y

# Home Assistant's first answers (the registries, every entity's state) run to
# hundreds of KB: with lwIP's 5.7 KB window that's a round trip every 4 packets,
# each one slow with Bluetooth sharing the radio. 32 KB (lwIP's buffers are in PSRAM).
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
# Software AES for TLS: hardware AES bounces every record that sits in PSRAM
# (MBEDTLS_EXTERNAL_MEM_ALLOC) through internal DMA RAM, and while Home Assistant's
# big answers arrive that allocation fails ("esp-aes: Failed to allocate memory")
# and the update check or download drops. Software AES is far faster than Wi-Fi.
CONFIG_MBEDTLS_HARDWARE_AES=n
