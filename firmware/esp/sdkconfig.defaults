# Bleep v1: ESP32-S3-WROOM-1-N8R2 (8 MB quad flash, 2 MB quad PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# PSRAM (quad: the octal kind would take GPIO35-37, which are LCD D0-D2)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Console on the native USB (GPIO43/44 are LCD D7 and WR, not UART0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS: 1 ms ticks for LVGL and the key scan
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Power management: frequency scaling and light sleep while awake (REQUIREMENTS.md)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Bluetooth LE only, NimBLE, as a HID peripheral
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Bleep"
# its buffers in PSRAM: internal RAM is short
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Updates over HTTPS with rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# LVGL: our lv_conf.h (main/), not Kconfig
CONFIG_LV_CONF_SKIP=n

# Internal RAM is what runs out (Wi-Fi, Bluetooth, TLS, the draw buffers): what
# doesn't need to be there goes to PSRAM or flash. Measured on the board.
# PSRAM holds LVGL's widgets: longer lines (no RAM cost)
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# TLS buffers in PSRAM (the update check ran out without)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# a remote needs little throughput
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
